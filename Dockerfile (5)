# Imagen base compartida por todos los contenedores PyBullet (se compila pybullet una sola vez).
FROM python:3.10-slim
RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential iproute2 iputils-ping netcat-openbsd \
    && pip install --no-cache-dir "pybullet==3.2.6" numpy "paho-mqtt<2" "websockets>=12" \
    && apt-get purge -y build-essential && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*
COPY common /app/common
RUN cp /app/common/entrypoint.sh /entrypoint.sh && chmod +x /entrypoint.sh
ENV PYTHONPATH=/app PYTHONUNBUFFERED=1
WORKDIR /app
ENTRYPOINT ["/entrypoint.sh"]
